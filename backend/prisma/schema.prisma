generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  refreshTokens       RefreshToken[]
  ingresos            Ingreso[]
  gastos              Gasto[]
  eventos             Evento[]
  ahorro              Ahorro?
  presupuestoImpuesto PresupuestoImpuesto?
  fondoEmergencia     FondoEmergencia?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Ingreso {
  id            String            @id @default(uuid())
  tipo          TipoIngreso
  categoria     CategoriaIngreso?
  descripcion   String?
  monto         Decimal           @db.Decimal(10, 2)
  fecha         DateTime
  metodoPago    MetodoPago
  estado        EstadoIngreso?
  cuentaDestino CuentaDestino
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("ingresos")
}

model Gasto {
  id          Int            @id @default(autoincrement())
  fecha       DateTime
  descripcion String
  monto       Decimal        @db.Decimal(10, 2)
  formaPago   FormaPago
  estado      EstadoGasto
  categoria   CategoriaGasto
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("gastos")
}

model Evento {
  id          String   @id @default(uuid())
  fecha       DateTime
  descripcion String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eventos")
}

model Ahorro {
  id           String    @id @default(uuid())
  metaAhorro   Decimal   @db.Decimal(12, 2)
  tipoCuota    TipoCuota
  montoCuota   Decimal   @db.Decimal(12, 2)
  ahorroActual Decimal   @default(0) @db.Decimal(12, 2)
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("ahorros")
}

model PresupuestoImpuesto {
  id        String   @id @default(uuid())
  monto     Decimal  @db.Decimal(12, 2)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("presupuestos_impuestos")
}

model FondoEmergencia {
  id        String    @id @default(uuid())
  monto     Decimal   @db.Decimal(12, 2)
  tipoCuota TipoCuota
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("fondos_emergencia")
}

enum Role {
  ADMIN
  USER
}

enum TipoIngreso {
  SUELDO_FIJO
  SUELDO_EXTRA
  SUELDO_VARIADO
}

enum CategoriaIngreso {
  SALARIO
  SERVICIOS
  VENTAS
  OTROS_INGRESOS
}

enum MetodoPago {
  TARJETA
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
}

enum EstadoIngreso {
  PAGADO
  PENDIENTE
  PARCIAL
}

enum CuentaDestino {
  AHORROS
  PAGOS
  GASTOS_PERSONALES
  INVERSIONES
  CONSUMO_PERSONAL
  CUENTAS_BANCARIAS
  OTROS
}

enum FormaPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum EstadoGasto {
  PAGADO
  POR_PAGAR
  DEBIENDO_A_OTRO
}

enum CategoriaGasto {
  EMPRESA
  PERSONAL
  TRABAJO
  OTRO
}

enum TipoCuota {
  SEMANAL
  MENSUAL
  ANUAL
}
